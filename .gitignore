# ambiente virtuale creato da uv
.venv/

# file di sistema e cache
.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/
.ruff_cache/

# file prodotti eseguendo i notebook
*.html
Output/

# file prodotti dagli esercizi nelle cartelle dei notebook (i dati veri stanno in Dati/ e nelle sue copie Aula_*/Dati/)
Aula_*/Modulo_*/*.csv
Aula_*/Modulo_*/*.xlsx
Aula_*/Modulo_*/*.py
!Aula_*/Modulo_*/corso.py
Aula_*/Soluzioni/*.csv
Aula_*/Soluzioni/*.xlsx
Aula_*/Soluzioni/*.py
!Aula_*/Soluzioni/corso.py
Riserva/*/*.csv
Riserva/*/*.xlsx

# quello che Run Python File o un esercizio di riserva lasciano nella radice di un'aula, e i file di blocco di Excel
Aula_*/*.csv
Aula_*/*.xlsx
Aula_*/*.py
~$*

# quello che una prova della demo o dell'esercizio su uv e Ruff lascia nelle loro cartelle
Aula_*/*/Script_uv_Ruff/*/*.xlsx
Aula_*/Modulo_*/Script_uv_Ruff/*/uv.lock

# gli zip per i corsisti, prodotti da _build/esporta.py
dist/

# worktree temporanei degli agenti
.claude/worktrees/
